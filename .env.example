# --- Server ---
PORT=3000

# --- LLM (valikuline) ---
# Kui LLM_ENABLED=false, tootab bot ainult regex-ruuteri ja
# eestikeelsete vastusesabloonidega. Koik 11 pohiintenti tootavad ka siis.
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Sekundid. CPU-l on qwen3:8b ~4,6 tok/s, seega ole helde.
LLM_TIMEOUT_S=120

# --- Cache ---
# Failicache kaust. Statistikaamet 24h, WFS 1h.
CACHE_DIR=.cache
CACHE_ENABLED=true
